[Unit]
Description=Rackhand probe helper
Before=rackhand-probe.service

[Service]
Type=simple
# root: the only root process of a probe machine (7.3.3); it takes no paths or URLs from its socket
ExecStart=/usr/local/lib/rackhand/rackhand-probe helper
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RuntimeDirectory=rackhand-helper
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=rackhand-helper
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
