# The Rackhand relay (design 7.3.10): unprivileged, and allowed to bind ports 80 and 443. Its key, its key bindings and its
# certificates live in /var/lib/rackhand-relay. Run `rackhand relay key create` as this user to issue a key.
[Unit]
Description=Rackhand relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rackhand-relay
Group=rackhand-relay
ExecStart=/usr/local/bin/rackhand relay run --data-dir /var/lib/rackhand-relay
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/rackhand-relay
StateDirectory=rackhand-relay
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
