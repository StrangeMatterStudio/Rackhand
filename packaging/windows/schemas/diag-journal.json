{
  "script": "diag-journal",
  "params": {
    "lines": {
      "type": "int",
      "pattern": "[1-9][0-9]{0,2}|1[0-9]{3}|2000"
    },
    "since": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}(:[0-9]{2})?)?|today|yesterday|[1-9][0-9]{0,2} (minutes?|hours?|days?) ago"
    },
    "unit": {
      "type": "string",
      "pattern": "[A-Za-z0-9@._:-]{1,128}"
    }
  }
}
