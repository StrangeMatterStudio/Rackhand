#!/sbin/openrc-run
# The Rackhand probe (7.3.2): sampling only, no capabilities, as its own user (7.3.3).
description="Rackhand probe"
command=/usr/local/lib/rackhand/rackhand-probe
command_args=run
command_user=rackhand-probe:rackhand-probe
command_background=true
pidfile=/run/rackhand-probe.pid

depend() {
	need net
	after rackhand-probe-helper
}

start_pre() {
	checkpath -d -m 0755 -o rackhand-probe:rackhand-probe /run/rackhand-probe
	checkpath -d -m 0700 -o rackhand-probe:rackhand-probe /var/lib/rackhand-probe
}
